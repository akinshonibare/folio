# --- Database (Neon) ---
DATABASE_URL=postgres://...
DATABASE_URL_UNPOOLED=postgres://...

# --- Auth (Clerk) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# --- Market data ---
# Yahoo Finance is used by default — no key needed.
# Set this to enable Polygon as an option; a per-user toggle in Settings then picks
# Yahoo (default) or Polygon. If unset, the Polygon toggle is hidden.
POLYGON_API_KEY=

# --- Sentiment (all free tiers) ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=folio/0.1 by yourname
